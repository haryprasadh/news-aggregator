# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Model slug on OpenRouter. Strong reasoning + tool-use recommended.
# Verify slug at https://openrouter.ai/models before changing.
# Examples (pick one):
#   anthropic/claude-sonnet-4.5
#   anthropic/claude-3.5-sonnet
#   openai/gpt-4o
#   google/gemini-2.5-pro
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Cheaper / faster fallback for the bulk digest summarisation step.
# Leave the same as OPENROUTER_MODEL if you don't want a fallback.
OPENROUTER_DIGEST_MODEL=openai/gpt-4o-mini

# Optional: web search. Pick ONE (Tavily is recommended). Without these
# the app still works but is limited to RSS/feeds for freshness.
TAVILY_API_KEY=
SERPER_API_KEY=

# OpenRouter recommends sending these so the dashboard shows your app.
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_TITLE=Local News Desk

# Server
HOST=127.0.0.1
PORT=8787

# Caps (keeps costs sane)
MAX_RSS_ITEMS_PER_PACK=40
MAX_SEARCH_CALLS_PER_DIGEST=4
MAX_TOOL_ITERATIONS_PER_CHAT=4
DIGEST_RECENCY_HOURS=24
